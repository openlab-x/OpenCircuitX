#include <windows.h>

// Application icon
// Place your icon at: OpenCircuitX/res/app.ico
// 256x256 recommended; include 16x16, 32x32, 48x48, and 256x256 sizes.
IDI_MAIN ICON "res\\app.ico"

// Version information embedded in the executable
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenLabX"
            VALUE "FileDescription",  "OpenCircuitX, Circuit & HDL Development IDE"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "OpenCircuitX"
            VALUE "LegalCopyright",   "Copyright (c) 2026 OpenLabX. MIT License."
            VALUE "OriginalFilename", "OpenCircuitX.exe"
            VALUE "ProductName",      "OpenCircuitX"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
